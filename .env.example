# Copy this file to .env.local for local development and fill in real values.
# In production (Vercel), add these under Project Settings -> Environment Variables instead.

# Resend API key used by the Contact page quote-request form (app/contact/actions.ts)
# to email submissions to Info@twinxinteriors.co.za. Get one free at https://resend.com
RESEND_API_KEY=

# Optional: the canonical site URL, used for social share (Open Graph) image resolution.
NEXT_PUBLIC_SITE_URL=https://twinx-interiors.vercel.app

# Optional: Cloudflare Turnstile (bot-check widget) for the Contact page form.
# Get a free site key + secret key at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset and the form still works, just without Turnstile's extra spam check
# (honeypot + time-trap checks in app/contact/actions.ts stay active either way).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
